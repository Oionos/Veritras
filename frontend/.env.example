# Browser-visible values only; never add private keys or service tokens.
# Use make testing-up for a complete isolated local stack.
# Hosted Preview requires VITE_APP_ENV=testing and separate testing API/contracts.
# QR links use the current origin, without query/access tokens.
# See PRODUCT_JOURNEY.md and HOSTED_TESTING.md.
VITE_APP_ENV=development
VITE_CHAIN_ID=11155111
# ============================================
# Veritras Frontend Environment Configuration
# ============================================

# API Configuration
# Base URL of the Veritras backend API.
# Example: https://api.veritras.app (production) or http://localhost:8000 (local)
VITE_API_URL=http://localhost:8000

# Blockchain Contract Addresses (Sepolia testnet)
# Fill with contracts for this environment. Blank development values disable actions.
VITE_PRODUCT_REGISTRY_CONTRACT=
VITE_SHIPMENT_TRACKER_CONTRACT=

# WalletConnect Project ID
# REQUIRED for RainbowKit wallet connections to work in production.
# 1. Go to https://cloud.walletconnect.com
# 2. Sign up / log in
# 3. Create a new project (name it "Veritras")
# 4. Copy the Project ID and paste it below
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here
