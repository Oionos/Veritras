# Veritras Backend — Production Environment Variables
# Copy this file to .env and fill in the real values.
# DO NOT commit .env to Git.
ENVIRONMENT=production
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ISSUER=veritras-api
JWT_AUDIENCE=veritras-web
SIWE_ORIGINS=https://veritras.vercel.app

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# SQLAlchemy-compatible PostgreSQL connection string.
# Railway/Render will provide this when you provision Postgres.
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/veritras

# ------------------------------------------------------------------------------
# Blockchain RPC
# ------------------------------------------------------------------------------
# Alchemy or Infura Sepolia endpoint.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# ------------------------------------------------------------------------------
# Contract Addresses (fill after Phase 1 deployment)
# ------------------------------------------------------------------------------
PRODUCT_REGISTRY_CONTRACT=0x1F76018532D619194f6628ADc186e3c86FcB5AaA
SHIPMENT_TRACKER_CONTRACT=0x95b09C0aeD53f6b63C072F4ecaC18861FcbBFB30

# ------------------------------------------------------------------------------
# API Server
# ------------------------------------------------------------------------------
# Inside a container these should remain 0.0.0.0:8000 unless you have a reason
# to change them. Railway/Render expose PORT automatically.
API_HOST=0.0.0.0
API_PORT=8000

# ------------------------------------------------------------------------------
# Indexer
# ------------------------------------------------------------------------------
# Seconds between blockchain polling loops.
# 60 is recommended for production to stay within RPC rate limits.
INDEXER_POLL_INTERVAL=60

# Block number where contracts were deployed. Prevents re-scanning from block 0.
# Find this in your deployment transaction receipt on Etherscan.
INDEXER_START_BLOCK=0

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# Include your Vercel production domain and any preview deployments.
CORS_ORIGINS=https://your-app.vercel.app,https://your-app-git-main.vercel.app
